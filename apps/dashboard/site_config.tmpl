server {
    listen 80;
    root {{.DocumentRoot}};
    index index.html;

    # Every text file this site serves is UTF-8. Nginx omits the charset
    # parameter from Content-Type unless asked, and this applies to every text
    # type it serves.
    charset utf-8;

    # The backend is looked up per request rather than once at start, so a
    # replaced backend container is found without restarting this one. A
    # `proxy_pass` through a variable is what makes nginx resolve at request
    # time, and then it asks `resolver` instead of reading /etc/resolv.conf.
    # 10.0.224.1 is the project network's resolver, read from /etc/resolv.conf
    # in this container. nginx does not apply the `zerops` search domain, so the
    # name is written in full. `ipv6=off` keeps nginx on the IPv4 address, so a
    # request never tries an IPv6 upstream first. A lookup is kept for 10
    # seconds. See architecture/zerops-networking.md.
    resolver 10.0.224.1 ipv6=off valid=10s;
    resolver_timeout 5s;
    set $backend_upstream backend.zerops:4000;

    # Browser-boundary headers for the admin dashboard, the one private surface.
    # Values come from `buildSecurityHeaders(SurfaceExposure.Private)` in
    # packages/shared/src/security-headers.ts, which is the source of truth the
    # two Astro apps read directly; nginx cannot, so they are written out here
    # and a test asserts the two stay identical.
    #
    # The complete content policy is enforced. The app ships no inline script,
    # so scripts load from this origin only. Styles may be inline, because the
    # editors, the overlays and the email preview write theirs at runtime; the
    # shared module says why at PRIVATE_STYLE_SOURCES.
    #
    # nginx does not merge add_header across levels: a location declaring its
    # own add_header replaces this whole set rather than adding to it.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; img-src 'self' data: https:; media-src 'self' https:; worker-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com; upgrade-insecure-requests; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # SSE endpoint. Buffering is off and the read timeout is long, because these
    # streams stay open.
    location /api/admin/events {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    # Auth requests are proxied by the generic /api/ block below. They carry no
    # upstream diagnostics, because this path is reachable without credentials:
    # $upstream_addr would publish the internal backend address, and a
    # server-measured response time is a login timing oracle free of network
    # noise. Diagnose from the backend's structured logs, which carry the
    # request id and the handler duration. See architecture/zerops-networking.md.
    location /api/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 10m;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
