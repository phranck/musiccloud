---
/**
 * /dashboard/usage: project quotas and registration-key usage at a glance (protected).
 *
 * Server-side: resolves the session, then loads the caller's clients
 * server-to-server (`getOwnApiClients`) and renders everything statically;
 * no island is needed because the page is a read-only snapshot. Shows each app's
 * enforced quota (requests/minute + requests/day) and each key's last-used
 * timestamp; detailed per-request analytics are a later, separate stage.
 */
import DashboardLayout from "@/components/dashboard/DashboardLayout.astro";
import { ApiContent } from "@/components/docs/ApiContent";
import { ContentCard } from "@/components/docs/ContentCard";
import { ContentPanel } from "@/components/docs/ContentPanel";
import { iconForDashboardTab } from "@/lib/dashboardNavIcons";
import { StatusBadge } from "@/components/dashboard/StatusBadge";
import { getOwnApiClients } from "@/lib/apiAccessServer";
import { DeveloperProjectStatus, maskToken } from "@/lib/apiAccessClient";
import { DashboardTab } from "@/lib/dashboardTabs";
import { formatDate } from "@/lib/formatDate";
import { DataIcon, DiagramIcon } from "@/lib/icons";
import { perDayQuotaLabel, perMinuteQuotaLabel } from "@/lib/quotaLabel";
import { getDeveloperSession } from "@/lib/session";

export const prerender = false;

// Session check and client list are independent backend reads (both key off
// the cookie), so they run in parallel instead of back-to-back.
const [account, clients] = await Promise.all([getDeveloperSession(Astro), getOwnApiClients(Astro)]);
if (!account) return Astro.redirect("/login");
const PageIcon = iconForDashboardTab(DashboardTab.Usage);
---

<DashboardLayout account={account} active={DashboardTab.Usage} title="Usage · musiccloud for developers">
  <ApiContent.Chapter.Header className="api-content__chapter-header--first">
    <ApiContent.Chapter.Header.Icon>
      <PageIcon aria-hidden="true" />
    </ApiContent.Chapter.Header.Icon>
    <ApiContent.Chapter.Header.Title>Usage</ApiContent.Chapter.Header.Title>
  </ApiContent.Chapter.Header>
  <p class="card-content-inset text-body text-fg-muted mb-6">Your enforced quotas per project, and when each registration key was last used.</p>

  {
    clients === null ? (
      <p class="card-content-inset field__message field__message--error">Could not load your usage data. Reload the page to try again.</p>
    ) : clients.length === 0 ? (
      <ContentCard>
        <ContentCard.Header>
          <ContentCard.Header.Icon>
            <DiagramIcon aria-hidden="true" />
          </ContentCard.Header.Icon>
          <ContentCard.Header.Title>Nothing to show yet</ContentCard.Header.Title>
        </ContentCard.Header>
        <ContentCard.Body>
          <ContentCard.Body.Copy>
            <p class="text-body text-fg-muted">Usage appears here once a project holds a registration.</p>
          </ContentCard.Body.Copy>
        </ContentCard.Body>
        <ContentCard.Footer>
          <a href="/dashboard/projects" class="button button--content">Create a project</a>
        </ContentCard.Footer>
      </ContentCard>
    ) : (
      <div class="flex flex-col gap-6">
        {clients.map((client) => (
          <ContentCard>
            <ContentCard.Header>
              <ContentCard.Header.Icon>
                <DataIcon aria-hidden="true" />
              </ContentCard.Header.Icon>
              <ContentCard.Header.Title>{client.projectDisplayName}</ContentCard.Header.Title>
              <ContentCard.Header.Addon>
                <StatusBadge
                  status={client.projectStatus === DeveloperProjectStatus.Active ? client.status : client.projectStatus}
                />
              </ContentCard.Header.Addon>
            </ContentCard.Header>
            <ContentCard.Body>
              <ContentCard.Body.Stack>
                <ContentPanel className="content-panel--inset">
                  <ContentPanel.Header>
                    <ContentPanel.Header.Title>
                      {client.appName} · {client.registrationType} · {client.publicClientId}
                    </ContentPanel.Header.Title>
                  </ContentPanel.Header>
                  <ContentPanel.Content>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                      <div>
                        <dt class="text-nav text-fg-subtle mb-0.5">Rate limit</dt>
                        <dd class="text-body text-fg">{perMinuteQuotaLabel(client.requestsPerMinute)}</dd>
                      </div>
                      <div>
                        <dt class="text-nav text-fg-subtle mb-0.5">Daily quota</dt>
                        <dd class="text-body text-fg">{perDayQuotaLabel(client.requestsPerDay)}</dd>
                      </div>
                    </dl>
                  </ContentPanel.Content>
                </ContentPanel>
                <ContentPanel className="content-panel--inset">
                  <ContentPanel.Header>
                    <ContentPanel.Header.Title>Registration keys</ContentPanel.Header.Title>
                  </ContentPanel.Header>
                  <ContentPanel.Content>
                    {client.tokens.length === 0 ? (
                      <p class="text-body text-fg-muted">No keys yet.</p>
                    ) : (
                      <ul class="flex flex-col divide-y divide-border">
                        {client.tokens.map((token) => (
                          <li class="py-2.5 first:pt-0 last:pb-0 flex flex-wrap items-center gap-x-3 gap-y-1">
                            <code class="text-code font-mono text-code-fg">{maskToken(token.tokenPrefix)}</code>
                            <StatusBadge status={token.status} />
                            <span class="text-nav text-fg-subtle">
                              Last used {token.lastUsedAt ? formatDate(token.lastUsedAt) : "never"}
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </ContentPanel.Content>
                </ContentPanel>
              </ContentCard.Body.Stack>
            </ContentCard.Body>
          </ContentCard>
        ))}
      </div>
    )
  }

  <p class="card-content-inset icon-text-first-line text-body text-fg-subtle mt-6 gap-2">
    <span class="icon-text-first-line__icon">
      <DiagramIcon aria-hidden="true" />
    </span>
    Detailed request analytics are coming later. This page will grow with them.
  </p>
</DashboardLayout>
