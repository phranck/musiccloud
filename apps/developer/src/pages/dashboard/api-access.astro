---
/**
 * /dashboard/api-access: kept as a redirect, not a screen.
 *
 * Access used to be applied for and granted, so this path carried a form and
 * the review history that followed it. A registration is now created directly
 * under a project, so the path sends a bookmark or an old link to the projects
 * list rather than showing a step that no longer exists.
 */
export const prerender = false;

return Astro.redirect("/dashboard/projects", 302);
---
