---
/**
 * /dashboard/api-keys: kept as a redirect, not a screen.
 *
 * Keys used to live in one flat account-wide list, because the old model had
 * nothing to group them by. They now live under the registration they belong
 * to, so this path sends a bookmark or an old link to the projects list rather
 * than showing a second version of the same thing.
 */
export const prerender = false;

return Astro.redirect("/dashboard/projects", 302);
---
