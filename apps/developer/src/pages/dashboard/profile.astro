---
/**
 * /dashboard/profile: the account details the operator needs in order to reach
 * a person (protected).
 *
 * Server-side: resolves the session and redirects to `/login` without one.
 * Shows the sign-in address read-only, because changing it is an identity
 * change rather than a contact change, and the technical contact address as an
 * island that can be set, changed and cleared.
 */
import DashboardLayout from "@/components/dashboard/DashboardLayout.astro";
import { TechnicalContactSection } from "@/components/dashboard/TechnicalContactSection";
import { DashboardTab } from "@/lib/dashboardTabs";
import { getDeveloperSession } from "@/lib/session";

export const prerender = false;

const account = await getDeveloperSession(Astro);
if (!account) return Astro.redirect("/login");
---

<DashboardLayout account={account} active={DashboardTab.Profile} title="Profile · musiccloud for developers">
  <h1 class="card-content-inset text-hero font-medium tracking-tight mb-1">Profile</h1>
  <p class="card-content-inset text-body text-fg-muted mb-7">
    How we identify your account, and how we reach you about the applications on it.
  </p>

  <section class="mb-6">
    <h2 class="card-content-inset text-card-title font-medium tracking-tight mb-3">Sign-in</h2>
    <dl class="surface-card px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <dt class="text-nav text-fg-subtle mb-0.5">Email</dt>
        <dd class="text-body text-fg">{account.email}</dd>
      </div>
      <div>
        <dt class="text-nav text-fg-subtle mb-0.5">Display name</dt>
        <dd class="text-body text-fg">{account.displayName ?? "Not set"}</dd>
      </div>
    </dl>
  </section>

  <TechnicalContactSection client:load technicalContactEmail={account.technicalContactEmail} />
</DashboardLayout>
