---
/**
 * /dashboard/projects/:id/plan: the plan step for one project (protected).
 *
 * Server-side: resolves the session, then loads the public plan catalogue. The
 * catalogue is fetched here rather than in the browser because the portal's
 * proxy only reaches `/api/dev/`, and because the plans do not change while
 * somebody looks at them.
 */
import DashboardLayout from "@/components/dashboard/DashboardLayout.astro";
import { DollarSquareIcon } from "@/lib/icons";
import { ApiContent } from "@/components/docs/ApiContent";
import { PlanPanel } from "@/components/dashboard/PlanPanel";
import { backendUrl, internalHeaders } from "@/lib/api";
import { DashboardTab } from "@/lib/dashboardTabs";
import { type PublicTier, toPlanOptions } from "@/lib/planOptions";
import { getDeveloperSession } from "@/lib/session";
import { ENDPOINTS } from "@musiccloud/shared";

export const prerender = false;

const account = await getDeveloperSession(Astro);
if (!account) return Astro.redirect("/login");

const { id } = Astro.params;
if (!id) return Astro.redirect("/dashboard/projects");

// A catalogue we cannot reach leaves the choice empty rather than the page
// broken; the panel says so, and the project keeps whatever plan it has.
let plans: ReturnType<typeof toPlanOptions> = [];
try {
  const response = await fetch(backendUrl(ENDPOINTS.v1.tiers), {
    headers: internalHeaders(Astro.clientAddress),
  });
  if (response.ok) plans = toPlanOptions((await response.json()) as PublicTier[]);
} catch {
  plans = [];
}
const PageIcon = DollarSquareIcon;
---

<DashboardLayout account={account} active={DashboardTab.Projects} activeProjectId={id} title="Plan · musiccloud for developers">
  <ApiContent.Chapter.Header className="api-content__chapter-header--first">
    <ApiContent.Chapter.Header.Icon>
      <PageIcon aria-hidden="true" />
    </ApiContent.Chapter.Header.Icon>
    <ApiContent.Chapter.Header.Title>Plan</ApiContent.Chapter.Header.Title>
  </ApiContent.Chapter.Header>
  <p class="card-content-inset text-body text-fg-muted mb-6">
    A plan says how much this project may do. <a href={`/dashboard/projects/${id}`} class="content-link">Back to the project</a>
  </p>

  <PlanPanel client:load projectId={id} plans={plans} />
</DashboardLayout>
