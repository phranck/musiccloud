---
/**
 * /dashboard/projects/:id: one project (protected).
 *
 * Server-side: resolves the session and redirects to `/login` without one. The
 * project itself is loaded in the browser, because every action on this screen
 * writes to the same endpoint it reads from, and ownership is enforced there:
 * a project belonging to somebody else answers 404 whether it is asked for
 * here or from a script.
 */
import DashboardLayout from "@/components/dashboard/DashboardLayout.astro";
import { iconForDashboardTab } from "@/lib/dashboardNavIcons";
import { ApiContent } from "@/components/docs/ApiContent";
import { ProjectDetailPanel } from "@/components/dashboard/ProjectDetailPanel";
import { DashboardTab } from "@/lib/dashboardTabs";
import { getDeveloperSession } from "@/lib/session";

export const prerender = false;

const account = await getDeveloperSession(Astro);
if (!account) return Astro.redirect("/login");

const { id } = Astro.params;
if (!id) return Astro.redirect("/dashboard/projects");
const PageIcon = iconForDashboardTab(DashboardTab.Projects);
---

<DashboardLayout account={account} active={DashboardTab.Projects} activeProjectId={id} title="Project · musiccloud for developers">
  <ApiContent.Chapter.Header className="api-content__chapter-header--first">
    <ApiContent.Chapter.Header.Icon>
      <PageIcon aria-hidden="true" />
    </ApiContent.Chapter.Header.Icon>
    <ApiContent.Chapter.Header.Title>Project</ApiContent.Chapter.Header.Title>
  </ApiContent.Chapter.Header>
  <p class="card-content-inset text-body text-fg-muted mb-6">
    <a href="/dashboard/projects" class="content-link">All projects</a>
  </p>

  <ProjectDetailPanel client:load projectId={id} />
</DashboardLayout>
