---
/**
 * /docs: what the API does and how to start using it.
 *
 * The route stays a route so the header knows which tab is current. What the
 * page says is content, edited in the dashboard, because these are the
 * sentences a developer reads before deciding whether to build against us and
 * they should be changeable in a minute.
 */
import PublicFooter from "@/components/PublicFooter.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import EditorialPage from "@/components/editorial/EditorialPage.astro";
import EditorialStatus from "@/components/editorial/EditorialStatus.astro";
import { fetchEditorialPage } from "@/lib/editorial";
import { getDeveloperSession } from "@/lib/session";
import BaseLayout from "@/layouts/BaseLayout.astro";

const result = await fetchEditorialPage("/docs");
if (result.status !== "success") Astro.response.status = 503;

const account = result.status === "success" ? null : await getDeveloperSession(Astro);
---

{
  result.status === "success" ? (
    <EditorialPage page={result.data} active="docs" bare />
  ) : (
    <BaseLayout
      title="Documentation · musiccloud for developers"
      description="How the musiccloud API works and how to get started building with it."
    >
      <PublicHeader account={account} active="docs" />
      <main class="developer-shell developer-page flex-1">
        <EditorialStatus
          title="Documentation unavailable"
          message="This page is temporarily unavailable. The API reference under /docs/api is unaffected."
        />
      </main>
      <PublicFooter />
    </BaseLayout>
  )
}
