---
/**
 * `/`: what the portal opens with.
 *
 * The route stays a route because it carries what a stored page cannot: the
 * header, the session, and the fallback shown when the page cannot be reached.
 * Everything a reader actually reads comes from the page, so a sentence on it
 * is an edit in the dashboard rather than a deployment.
 *
 * It marks no header tab as current, because the home page belongs to none.
 */
import PublicFooter from "@/components/PublicFooter.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import EditorialPage from "@/components/editorial/EditorialPage.astro";
import EditorialStatus from "@/components/editorial/EditorialStatus.astro";
import { fetchEditorialPage } from "@/lib/editorial";
import { getDeveloperSession } from "@/lib/session";
import BaseLayout from "@/layouts/BaseLayout.astro";

const result = await fetchEditorialPage("/");
if (result.status !== "success") Astro.response.status = 503;

const account = result.status === "success" ? null : await getDeveloperSession(Astro);
---

{
  result.status === "success" ? (
    <EditorialPage page={result.data} bare />
  ) : (
    <BaseLayout
      title="musiccloud for developers"
      description="Build with the musiccloud API."
    >
      <PublicHeader account={account} />
      <main class="developer-shell developer-page flex-1">
        <EditorialStatus
          title="Home unavailable"
          message="This page is temporarily unavailable. The API itself is unaffected by this."
        />
      </main>
      <PublicFooter />
    </BaseLayout>
  )
}
