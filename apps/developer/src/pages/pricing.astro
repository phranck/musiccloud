---
/**
 * /pricing: the plans and the written commitment.
 *
 * The route stays a route because it carries two things a stored page cannot:
 * which header tab is current, and the notice shown to somebody who arrived
 * from a signup that needs a plan chosen. Everything a reader actually reads
 * comes from the page, so a sentence on it is an edit in the dashboard rather
 * than a deployment.
 */
import PublicFooter from "@/components/PublicFooter.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import EditorialPage from "@/components/editorial/EditorialPage.astro";
import EditorialStatus from "@/components/editorial/EditorialStatus.astro";
import { fetchEditorialPage } from "@/lib/editorial";
import { getDeveloperSession } from "@/lib/session";
import BaseLayout from "@/layouts/BaseLayout.astro";

const result = await fetchEditorialPage("/pricing");
if (result.status !== "success") Astro.response.status = 503;

const account = result.status === "success" ? null : await getDeveloperSession(Astro);
const signupRequired = Astro.url.searchParams.get("signup") === "required";
---

{
  result.status === "success" ? (
    <EditorialPage
      page={result.data}
      active="pricing"
      notice={signupRequired ? "Choose a plan to create your account." : ""}
      bare
    />
  ) : (
    <BaseLayout
      title="Pricing · musiccloud for developers"
      description="The musiccloud API is free while we build it out. Here is our written commitment for what happens when paid plans arrive."
    >
      <PublicHeader account={account} active="pricing" />
      <main class="developer-shell developer-page flex-1">
        <EditorialStatus
          title="Pricing unavailable"
          message="The pricing page is temporarily unavailable. The free plan is unaffected by this."
        />
      </main>
      <PublicFooter />
    </BaseLayout>
  )
}
