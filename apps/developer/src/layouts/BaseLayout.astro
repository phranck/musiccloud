---
/**
 * BaseLayout is the HTML shell every developer-portal page renders into:
 * head metadata, the self-hosted font stack from `lib/fonts.ts`, the global
 * token stylesheet and the night-sky background layer.
 */
import "../styles/global.css";
import DeveloperBackground from "@/components/DeveloperBackground.astro";
import { PORTAL_FONT_FACE_CSS, PORTAL_FONTS } from "@/lib/fonts";

interface Props {
  title?: string;
  description?: string;
}

const { title = "musiccloud for developers", description = "Build with the musiccloud API." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/developer-theme.css" />
    {PORTAL_FONTS.map(({ url }) => <link rel="preload" as="font" type="font/woff2" crossorigin href={url} />)}
    <style is:inline set:html={PORTAL_FONT_FACE_CSS}></style>
  </head>
  <body class="min-h-screen flex flex-col text-fg font-sans antialiased">
    <DeveloperBackground />
    <slot />
  </body>
</html>
