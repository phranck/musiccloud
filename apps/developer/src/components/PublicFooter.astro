---
/**
 * PublicFooter is the shared bottom bar of every developer-portal page: the
 * public ones, and the auth screens through `AuthCard`.
 *
 * It says who the portal belongs to on the left, carries the managed footer
 * navigation in the middle, and says who built it on the right. It takes the
 * same material as `PublicHeader`, so a page is closed by the band it was
 * opened with.
 *
 * The middle is managed content, not a list written here. What stands there is
 * an operator's decision, taken in the admin, and a link written into this file
 * would be a second place to take it.
 *
 * The year is read per request, which the portal renders as (`output: "server"`),
 * so it cannot be frozen at whatever a build happened to be made in.
 */
import type { DeveloperPortalNavigationItem } from "@musiccloud/shared";
import { NavigationArea } from "@musiccloud/shared";
import { getDeveloperPortalNavigation } from "@/lib/editorial";

interface Props {
  /** Explicit managed data for isolated rendering; normal SSR loads Footer. */
  navigation?: readonly DeveloperPortalNavigationItem[];
}

const { navigation: suppliedNavigation } = Astro.props;
const navigation = suppliedNavigation ?? (await getDeveloperPortalNavigation(NavigationArea.Footer));

const year = new Date().getFullYear();
---

<footer class="public-footer">
  <div class="public-footer__inner developer-shell">
    <span>© {year} musiccloud</span>

    <nav class="public-footer__navigation" aria-label="Footer">
      {
        navigation.map((link) => {
          const isExternal = link.target === "_blank";
          return (
            <a
              href={link.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              class="content-link"
              data-public-search-command={link.behavior === "open-api-search" ? "true" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <span class="public-footer__credit">
      made by <a
        href="https://layered.work"
        target="_blank"
        rel="noopener noreferrer"
        class="content-link text-fg">LAYERED</a
      >
    </span>
  </div>
</footer>
