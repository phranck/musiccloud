---
/**
 * PublicFooter is the shared bottom bar of every developer-portal page: the
 * public ones, and the auth screens through `AuthCard`.
 *
 * It says who the portal belongs to on the left, where the legal pages are in
 * the middle, and who built it on the right. It takes the same material as
 * `PublicHeader`, so a page is closed by the band it was opened with.
 *
 * The year is read per request, which the portal renders as (`output: "server"`),
 * so it cannot be frozen at whatever a build happened to be made in.
 */

/** The pages a visitor is entitled to find from anywhere in the portal. */
const LEGAL_LINKS: readonly { href: string; label: string }[] = [
  { href: "/imprint", label: "Imprint" },
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
];

const year = new Date().getFullYear();
---

<footer class="public-footer">
  <div class="public-footer__inner developer-shell">
    <span>© {year} musiccloud</span>

    <nav class="public-footer__legal" aria-label="Legal">
      {LEGAL_LINKS.map(({ href, label }) => <a href={href} class="content-link">{label}</a>)}
    </nav>

    <span class="public-footer__credit">
      made by <a
        href="https://layered.work"
        target="_blank"
        rel="noopener noreferrer"
        class="content-link text-fg">LAYERED</a
      >
    </span>
  </div>
</footer>
