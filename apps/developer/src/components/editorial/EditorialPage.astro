---
/** Shared Developer Portal shell for one published managed editorial Page. */
import type { DeveloperPortalEditorialPage } from "@musiccloud/shared";
import type { PublicNavigationId } from "@/lib/publicNavigation";
import PublicFooter from "@/components/PublicFooter.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import { SurfaceCard } from "@/components/SurfaceCard";
import { portalPageIcon } from "@/lib/portalPageIcon";
import { getDeveloperSession } from "@/lib/session";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/editorial.css";
import EditorialMarkdown from "./EditorialMarkdown.astro";

interface Props {
  page: DeveloperPortalEditorialPage;
  /**
   * Which header tab to mark as current.
   *
   * A stored page cannot know this, because the header is the portal's and the
   * page is content. The two routes that serve a page from a fixed path pass
   * it; a page reached through the catch-all marks nothing, which is correct
   * because it belongs to no tab.
   */
  active?: PublicNavigationId;
  /**
   * A sentence shown above the page, for a state the route knows and the page
   * does not, such as having arrived here from a signup that needs a plan.
   */
  notice?: string;
  /**
   * Whether the page brings its own cards and wants no card around them.
   *
   * An editorial page normally sits inside one surface, which is what gives a
   * wall of prose an edge. A page built from cards already has edges, and a
   * card around cards reads as a frame nobody drew.
   */
  bare?: boolean;
}

const { page, active, notice = "", bare = false } = Astro.props;
const account = await getDeveloperSession(Astro);
const PageIcon = portalPageIcon(page.path);
---

<BaseLayout title={`${page.title} · musiccloud for developers`} description={page.title}>
  <PublicHeader account={account} active={active} />

  <main
    class="developer-shell developer-page editorial-page flex-1"
    data-template-key={page.templateKey}
    data-display-mode={page.displayMode}
  >
    {
      notice && (
        <p class="rounded-card border border-border bg-surface px-5 py-3 text-body text-fg-muted mb-8">{notice}</p>
      )
    }
    {
      page.showTitle ? (
        <div class:list={["page-heading", `editorial-page__heading--${page.titleAlignment}`]}>
          {PageIcon && <PageIcon className="page-heading__icon" aria-hidden="true" />}
          <h1 class="page-heading__title">{page.title}</h1>
        </div>
      ) : (
        <h1 class="sr-only">{page.title}</h1>
      )
    }

    {
      bare ? (
        <EditorialMarkdown html={page.contentHtml} plain />
      ) : (
        <SurfaceCard data-content-card-style={page.contentCardStyle}>
          <SurfaceCard.Body>
            <EditorialMarkdown html={page.contentHtml} />
          </SurfaceCard.Body>
        </SurfaceCard>
      )
    }
  </main>

  <PublicFooter />
</BaseLayout>
