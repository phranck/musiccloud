---
/**
 * Single injection boundary for Backend-sanitized Developer Portal Markdown HTML.
 *
 * Most of a page is one run of markup. Where a shortcode needs something the
 * backend cannot produce, such as the live plans, the page arrives with a
 * placeholder in its place and this renders the portal's own component there.
 */
import PlanGrid from "@/components/plans/PlanGrid.astro";
import { EditorialSegmentKind, splitEditorialSegments } from "@/lib/editorialIslands";

interface Props {
  html: string;
  /**
   * Whether the page is built from cards rather than being a wall of prose.
   *
   * The two differ in more than the card around them. Prose is set at the
   * editorial reading measure; a built page follows the portal's own
   * typography, which is what its hand-written version used and what the
   * components standing in it expect.
   */
  plain?: boolean;
}

const { html, plain = false } = Astro.props;
const segments = splitEditorialSegments(html);
---

<div class:list={["editorial-markdown text-body", plain ? "editorial-markdown--plain" : "text-fg-muted"]}>
  {
    segments.map((segment) =>
      segment.kind === EditorialSegmentKind.Plans ? (
        <PlanGrid />
      ) : (
        <Fragment set:html={segment.html} />
      ),
    )
  }
</div>

<script>
  import { YOUTUBE_EMBED_HOST, YOUTUBE_FRAME_PERMISSIONS, YOUTUBE_FRAME_SANDBOX } from "@musiccloud/shared";

  /**
   * Swaps a video's link for its frame when a reader asks for it.
   *
   * The page arrives with a link rather than a frame, so nothing reaches
   * YouTube for anybody who never plays the video. The link already stands at
   * the shape the frame will take, so the swap moves nothing on the page.
   *
   * The address is checked again here even though the renderer built it, because
   * this reads it back off the document and a page's markup is not a promise.
   */
  function playVideo(link: HTMLAnchorElement): void {
    const address = new URL(link.href, window.location.origin);
    if (address.origin !== YOUTUBE_EMBED_HOST) return;

    address.searchParams.set("autoplay", "1");

    const frame = document.createElement("iframe");
    frame.src = address.toString();
    frame.title = link.textContent?.trim() ?? "Video";
    frame.allow = YOUTUBE_FRAME_PERMISSIONS;
    frame.setAttribute("sandbox", YOUTUBE_FRAME_SANDBOX);
    frame.allowFullscreen = true;
    frame.style.aspectRatio = link.style.aspectRatio;

    link.replaceWith(frame);
  }

  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.(".mc-video__link");
    if (!(link instanceof HTMLAnchorElement)) return;

    event.preventDefault();
    playVideo(link);
  });
</script>
