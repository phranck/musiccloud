---
/**
 * Single injection boundary for Backend-sanitized Developer Portal Markdown HTML.
 *
 * Most of a page is one run of markup. Where a shortcode needs something the
 * backend cannot produce, such as the live plans, the page arrives with a
 * placeholder in its place and this renders the portal's own component there.
 */
import PlanGrid from "@/components/plans/PlanGrid.astro";
import { EditorialSegmentKind, splitEditorialSegments } from "@/lib/editorialIslands";

interface Props {
  html: string;
  /**
   * Whether the page is built from cards rather than being a wall of prose.
   *
   * The two differ in more than the card around them. Prose is set at the
   * editorial reading measure; a built page follows the portal's own
   * typography, which is what its hand-written version used and what the
   * components standing in it expect.
   */
  plain?: boolean;
}

const { html, plain = false } = Astro.props;
const segments = splitEditorialSegments(html);
---

<div class:list={["editorial-markdown text-body", plain ? "editorial-markdown--plain" : "text-fg-muted"]}>
  {
    segments.map((segment) =>
      segment.kind === EditorialSegmentKind.Plans ? (
        <PlanGrid />
      ) : (
        <Fragment set:html={segment.html} />
      ),
    )
  }
</div>
