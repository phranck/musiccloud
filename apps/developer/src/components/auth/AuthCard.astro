---
/**
 * AuthCard is the centred card shell shared by every developer-portal auth
 * screen (login, signup, verify, forgot, reset).
 *
 * Layout: the site's own header and footer, and between them a max-width column
 * centred in what is left, holding the card and a `footer` slot for secondary
 * links (e.g. "No account? Sign up").
 *
 * The header carries the wordmark and nothing else. An auth screen is one task,
 * and the ways out of it belong to the card rather than to a navigation bar
 * offering a tour of the portal to somebody halfway through signing in.
 *
 * The card interior belongs to whatever fills the default slot, because the
 * form has to span both the body and the footer for its submit to sit at the
 * card's bottom right.
 *
 * The card is `ContentCard`, the one the API reference uses, so an auth screen
 * carries the same header bar, the same inset and the same corner geometry as
 * every other surface in the portal. `.api-reference-shell` is what declares
 * the tokens those rules read, so the column opts into it the way the
 * dashboard shell does.
 */
import { ContentCard } from "@/components/docs/ContentCard";
import PublicFooter from "@/components/PublicFooter.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import "../../styles/docs.css";

interface Props {
  /** Heading shown in the card's header bar. */
  title: string;
  /** The symbol shown beside the title, as every card header carries one. */
  icon: (props: { "aria-hidden"?: "true" }) => unknown;
}

const { title, icon: Icon } = Astro.props;
const hasFooter = Astro.slots.has("footer");
---

<PublicHeader account={null} showNavigation={false} />

<main class="flex-1 flex items-center justify-center px-6 py-12">
  <div class="api-reference-shell auth-card w-full max-w-md">
    <ContentCard>
      <ContentCard.Header>
        <ContentCard.Header.Icon>
          <Icon aria-hidden="true" />
        </ContentCard.Header.Icon>
        <ContentCard.Header.Title>{title}</ContentCard.Header.Title>
      </ContentCard.Header>
      <slot />
    </ContentCard>

    {
      hasFooter && (
        <p class="text-body text-fg-muted text-center mt-6">
          <slot name="footer" />
        </p>
      )
    }
  </div>
</main>

<PublicFooter />
