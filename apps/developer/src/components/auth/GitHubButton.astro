---
/**
 * GitHubButton is the "Continue with GitHub" link that starts the server-side
 * OAuth flow at `/auth/github`.
 *
 * GitHub publishes no button of its own, only the mark and the rules for it:
 * it is shown unaltered, in white or black, on a background that keeps it
 * legible. This uses the portal's own button recipe with the mark in white,
 * which satisfies both that and the portal's own rule that nothing is filled
 * with a solid colour.
 *
 * The card body lays its children out in a single grid column, which stretches
 * them, so the button states `justify-self-start` to keep its label width. That
 * is placement at the call site, not a change to the button recipe.
 *
 * The Phosphor `GithubLogoIcon` renders as a static SSR SVG; no client
 * directive is needed because it carries no interactivity. It deliberately
 * stays a Phosphor icon: the portal's Iconsax set (MC-103, see
 * `@/lib/icons`) contains no brand marks, and inlining the GitHub logo as
 * raw SVG is off-limits per the icon rules.
 */
import { GithubLogoIcon } from "@phosphor-icons/react";

/**
 * Props for {@link GitHubButton}.
 *
 * @property intent - Whether the button starts a sign-in or a sign-up flow.
 *   Forwarded as `?intent=<value>` to the BFF start route so the backend can
 *   embed the intent in the signed OAuth `state` and enforce it at the exchange
 *   step (e.g. returning HTTP 409 when an unknown GitHub identity attempts to
 *   sign in). Defaults to `"login"`.
 */
interface Props {
  intent?: "login" | "signup";
}

const { intent = "login" } = Astro.props;
---

<a href={`/auth/github?intent=${intent}`} class="button button--secondary justify-self-start text-body">
  <GithubLogoIcon weight="fill" className="size-5 text-fg" aria-hidden="true" />
  Continue with GitHub
</a>
