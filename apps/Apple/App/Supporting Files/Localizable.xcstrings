    "Writes the last 6 hours of app logs to a file you can send to support. Only available in Testflight builds." : {
      "comment" : "A description of the diagnostics feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloží protokoly aplikace za posledních 6 hodin do souboru, který můžete odeslat podpoře. K dispozici pouze v sestaveních TestFlight."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt die App-Logs der letzten 6 Stunden in eine Datei, die an den Support gesendet werden kann. Nur in Testflight-Builds verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda los registros de la app de las últimas 6 horas en un archivo que puedes enviar al soporte. Solo disponible en compilaciones de TestFlight."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les journaux de l'app des 6 dernières heures dans un fichier à envoyer à l'assistance. Disponible uniquement dans les builds TestFlight."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i log dell'app delle ultime 6 ore in un file da inviare al supporto. Disponibile solo nelle build TestFlight."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft de app-logs van de afgelopen 6 uur naar een bestand dat je naar support kunt sturen. Alleen beschikbaar in TestFlight-builds."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 6 saatin uygulama günlüklerini destek ekibine gönderebileceğiniz bir dosyaya yazar. Yalnızca TestFlight sürümlerinde kullanılabilir."
          }
        }
      }
    },
