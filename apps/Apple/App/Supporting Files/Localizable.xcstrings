    "Each account below says whether it takes part and with which template. A link that is already in the history is not posted again." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Každý účet níže uvádí, zda se zapojuje a s jakou šablonou. Odkaz, který je již v historii, se znovu nepublikuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes Konto unten zeigt an, ob es teilnimmt und mit welchem Template. Ein Link, der bereits im Verlauf vorhanden ist, wird nicht erneut gepostet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada cuenta de abajo indica si participa y con qué plantilla. Un enlace que ya está en el historial no se vuelve a publicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque compte ci-dessous indique s’il participe et avec quel modèle. Un lien déjà présent dans l’historique n’est pas publié à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni account qui sotto indica se partecipa e con quale modello. Un link già presente nella cronologia non viene pubblicato di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elk account hieronder laat zien of het meedoet en met welk sjabloon. Een link die al in de geschiedenis staat, wordt niet opnieuw gepost."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aşağıdaki her hesap, paylaşıma katılıp katılmadığını ve hangi şablonu kullandığını belirtir. Geçmişte zaten bulunan bir bağlantı yeniden paylaşılmaz."
          }
        }
      }
    },
    "Each account below says whether it takes part. It posts with its default template. A link that is already in the history is not posted again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Každý účet níže uvádí, zda se zapojuje. Publikuje svou výchozí šablonou. Odkaz, který je již v historii, se znovu nepublikuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jedes Konto unten zeigt an, ob es teilnimmt. Es postet mit seinem Standard-Template. Ein Link, der bereits im Verlauf vorhanden ist, wird nicht erneut gepostet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada cuenta de abajo indica si participa. Publica con su plantilla predeterminada. Un enlace que ya está en el historial no se vuelve a publicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque compte ci-dessous indique s’il participe. Il publie avec son modèle par défaut. Un lien déjà présent dans l’historique n’est pas publié à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ogni account qui sotto indica se partecipa. Pubblica con il suo modello predefinito. Un link già presente nella cronologia non viene pubblicato di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Elk account hieronder laat zien of het meedoet. Het post met zijn standaardsjabloon. Een link die al in de geschiedenis staat, wordt niet opnieuw gepost."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aşağıdaki her hesap, paylaşıma katılıp katılmadığını belirtir. Saptanmış şablonuyla paylaşır. Geçmişte zaten bulunan bir bağlantı yeniden paylaşılmaz."
