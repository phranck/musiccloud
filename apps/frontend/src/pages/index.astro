---
import { SITE_ORIGIN, visitorAddress } from "@musiccloud/shared";
import { fetchCcRandomExample, fetchNavigation, fetchRandomExample } from "@/api/client";
import { LandingPage } from "@/components/landing/LandingPage";
import { PageOverlayIsland } from "@/components/layout/PageOverlayIsland";
import SocialMeta from "@/components/seo/SocialMeta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SHARE_REDIRECT_SCRIPT } from "@/lib/inline-scripts";
import { SITE_DESCRIPTION, SITE_NAME, SITE_SHARE_IMAGE } from "@/lib/seo/siteMeta";
import { loadSupportPrompts } from "@/lib/support/support-prompts";

// Independent calls, requested together: the first byte waits for the slowest
// of them, not for their sum.
const [footerNav, randomExample, ccRandomExample, supportPrompts] = await Promise.all([
  fetchNavigation("footer", visitorAddress(Astro)),
  fetchRandomExample(visitorAddress(Astro)),
  fetchCcRandomExample(visitorAddress(Astro)),
  loadSupportPrompts("landing-page", visitorAddress(Astro)),
]);
const exampleShortId = randomExample?.shortId ?? null;
const ccExampleShortId = ccRandomExample?.shortId ?? null;
---

<BaseLayout
  title="musiccloud - Share music across every platform"
  description={SITE_DESCRIPTION}
  canonicalUrl={SITE_ORIGIN.site}
>
  <Fragment slot="head">
    <meta name="title" content="musiccloud - Share music across every platform" />

    <SocialMeta title={SITE_NAME} description={SITE_DESCRIPTION} url={SITE_ORIGIN.site} />

    <!-- JSON-LD: WebApplication -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "musiccloud",
      "description": "Share music across every platform",
      "url": SITE_ORIGIN.site,
      "image": SITE_SHARE_IMAGE.url,
      "applicationCategory": "MusicApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })} />
  </Fragment>

  <!-- Redirect ?share=<streaming-url> to the share page before React hydration. See `lib/inline-scripts.ts`. -->
  <script is:inline set:html={SHARE_REDIRECT_SCRIPT}></script>

  <div class="min-h-dvh flex flex-col">
    <LandingPage
      client:idle
      footerNav={footerNav}
      exampleShortId={exampleShortId}
      ccExampleShortId={ccExampleShortId}
      supportPrompts={supportPrompts}
    />
  </div>

  <!-- Mounted with null initialPage so nav clicks on overlay-mode pages
       open client-side (no full reload). OverlayProvider advertises its
       presence via window.__mcOverlayActive for PageHeader.handleNavClick. -->
  <PageOverlayIsland client:load initialPage={null} />

  <!-- SSR fallback for no-JS -->
  <noscript>
    <main style="max-width: 640px; margin: 0 auto; padding: 4rem 1rem; text-align: center; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif;">
      <h1 style="font-size: 1.5rem; font-weight: bold; color: var(--color-text-primary); margin-bottom: 0.5rem;">
        musiccloud
      </h1>
      <p style="font-size: 1.25rem; color: var(--color-text-primary); margin-bottom: 2rem;">
        Paste a link or search by name. Share it everywhere.
      </p>
      <p style="color: #86868B;">
        This app requires JavaScript to work. Please enable JavaScript in your browser.
      </p>
    </main>
  </noscript>
</BaseLayout>
