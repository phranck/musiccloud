---
/**
 * Share or public content page, synchronously rendered for every client.
 *
 * The same response carries the rendered body and the canonical, OpenGraph and
 * Twitter metadata. Crawlers and browsers therefore never depend on a deferred
 * share-island request or a user-agent classifier to obtain the document data.
 */
export const prerender = false;

import { type ApiErrorResponse, type PublicContentPage, type SharePageResponse, SITE_ORIGIN, visitorAddress } from "@musiccloud/shared";
import { fetchPublicContentPage, fetchRandomExample, fetchShareData } from "@/api/client";
import { LandingPage } from "@/components/landing/LandingPage";
import { ContentPageMarkdown } from "@/components/layout/ContentPageMarkdown";
import DeferredFooter from "@/components/layout/DeferredFooter.astro";
import { MD_FULLSCREEN } from "@/components/layout/overlayContentProseClassMaps";
import { PageOverlayIsland } from "@/components/layout/PageOverlayIsland";
import { SegmentedPageFullscreen } from "@/components/layout/SegmentedPageFullscreen";
import { MarkdownHtml } from "@/components/markdown/MarkdownHtml";
import { CcSharePageShell } from "@/components/share/CcSharePageShell";
import { ShareErrorShell } from "@/components/share/ShareErrorShell";
import { SharePageShell } from "@/components/share/SharePageShell";
import { commonCopy } from "@/copy/common";
import { shareCopy } from "@/copy/share";
import { SHARE_MEDIA_VIEW_SCRIPT } from "@/lib/inline-scripts";
import { isBot } from "@/lib/isBot";
import { resolveShortRouteResults } from "@/lib/share/short-route-result";
import { loadSupportPrompts } from "@/lib/support/support-prompts";
import {
  buildCcSharePageProps,
  type CcSharePageProps,
  buildShareViewFromSharePageResponse,
  isCcSharePageResponse,
  type ShareViewModel,
} from "@/lib/share/share-view";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { shortId } = Astro.params;

if (!shortId) {
  return Astro.redirect("/");
}

const renderStaticContent = isBot(Astro.request.headers.get("user-agent"));
const clientIp = visitorAddress(Astro);
const correlationId = crypto.randomUUID();
const shareTiming = { correlationId, contentFetchMs: 0, shareFetchMs: 0 };
Astro.locals.shareTiming = shareTiming;
const contentStartedAt = performance.now();
const shareStartedAt = performance.now();
// The support prompts are asked for alongside, so a share page waits for the
// slowest of the three rather than for the prompts after the share. A content
// page does not use them; the request is cheap and never fails the page.
const [contentResult, shareResult, supportPrompts] = await Promise.all([
  fetchPublicContentPage(shortId, clientIp).finally(() => {
    shareTiming.contentFetchMs = Math.max(0, Math.round(performance.now() - contentStartedAt));
  }),
  fetchShareData(shortId, clientIp, Astro.request.headers, correlationId).finally(() => {
    shareTiming.shareFetchMs = Math.max(0, Math.round(performance.now() - shareStartedAt));
  }),
  loadSupportPrompts("share-page", clientIp),
]);
const routeResult = resolveShortRouteResults(contentResult, shareResult);

if (routeResult.kind === "not-found") {
  return Astro.redirect("/404", 302);
}

let contentPage: PublicContentPage | null = null;
let data: SharePageResponse | null = null;
let routeError: ApiErrorResponse | null = null;
let isAlbum = false;
let isArtist = false;
let og: SharePageResponse["og"] | null = null;
let artworkUrl: string | undefined | null = null;
let displayTitle = "";
let artistDisplay = "";
let shareView: ShareViewModel | null = null;
let ccPageProps: CcSharePageProps | null = null;
let pageTitle = "musiccloud";
const errorLabels = {
  back: shareCopy.error.back,
  code: shareCopy.error.code,
  copied: shareCopy.error.copied,
  copy: shareCopy.error.copy,
  description: shareCopy.error.description,
  reference: shareCopy.error.reference,
  title: shareCopy.error.title,
};

if (routeResult.kind === "error") {
  Astro.response.status = routeResult.statusCode;
  routeError = routeResult.error;
  pageTitle = errorLabels.title;
} else if (routeResult.kind === "content") {
  contentPage = routeResult.data;
} else {
  data = routeResult.data;
}

if (data && isCcSharePageResponse(data)) {
  ccPageProps = buildCcSharePageProps(data);
  isAlbum = data.type === "cc-album";
  isArtist = data.type === "cc-artist";
  og = data.og;
  artworkUrl = ccPageProps.artworkUrl;
  displayTitle = ccPageProps.config.title;
  artistDisplay = ccPageProps.config.artist;
  pageTitle = ccPageProps.pageTitle;
} else {
  shareView = data ? buildShareViewFromSharePageResponse(data, shortId) : null;
  isAlbum = shareView?.isAlbum ?? false;
  isArtist = shareView?.isArtist ?? false;
  og = data?.og ?? null;
  artworkUrl = shareView?.artworkUrl;
  displayTitle = shareView?.displayTitle ?? "";
  artistDisplay = shareView?.artistDisplay ?? "";
  pageTitle = contentPage ? `${contentPage.title} - musiccloud` : (shareView?.pageTitle ?? "musiccloud");
}

const overlayMode = !!contentPage && contentPage.displayMode !== "fullscreen";
const exampleShortId = overlayMode ? ((await fetchRandomExample(clientIp))?.shortId ?? null) : null;
---

<BaseLayout
  title={pageTitle}
  canonicalUrl={contentPage ? `${SITE_ORIGIN.site}/${contentPage.slug}` : og?.url}
  preloadImage={artworkUrl ?? undefined}
>
  <Fragment slot="head">
    <script is:inline set:html={SHARE_MEDIA_VIEW_SCRIPT}></script>
  </Fragment>

  {og && (
    <Fragment slot="head">
      <meta property="og:type" content={isArtist ? "profile" : isAlbum ? "music.album" : "music.song"} />
      <meta property="og:title" content={og.title} />
      <meta property="og:description" content={og.description} />
      {og.image && <meta property="og:image" content={og.image} />}
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={isArtist ? displayTitle : `${displayTitle} by ${artistDisplay}`} />
      <meta property="og:url" content={og.url} />
      <meta property="og:site_name" content="musiccloud" />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={og.title} />
      <meta name="twitter:description" content={og.description} />
      {og.image && <meta name="twitter:image" content={og.image} />}

      <link rel="dns-prefetch" href="//i.scdn.co" />
    </Fragment>
  )}

  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg">
    {commonCopy.a11y.skipToContent}
  </a>

  <div class="min-h-dvh flex flex-col">
    {routeError && <ShareErrorShell client:load error={routeError} labels={errorLabels} />}

    {/* The wrapper spans the viewport and clips sideways. An embossed card's
        shadow plate reaches past the card, and on a phone the column's padding
        is narrower than that reach, so without the clip the page scrolls
        sideways by the overhang. Clipping at the viewport edge, rather than at
        the column, keeps the shadows whole on a wide screen. */}
    {contentPage && contentPage.displayMode === "fullscreen" && (
      <div class="flex-1 flex flex-col w-full overflow-x-clip">
      {/* The text column is `max-w-page` (810px, lmaa.space's measure); the
          column's padding stands outside it, so the cap is the measure plus
          `sm:px-6` on both sides. The title takes lmaa's 40.5px and 24.3px
          below it, and stands on the sky, so it carries the sky text shadow. */}
      <main id="main-content" class="flex-1 w-full max-w-[calc(var(--container-page)+3rem)] mx-auto px-4 sm:px-6 pt-content-safe pb-12 animate-slide-up">
        {contentPage.showTitle && contentPage.pageType !== "segmented" && (
          <h1
            class:list={[
              "mc-sky-text text-3xl sm:text-[40.5px] font-bold tracking-[-0.04em] mb-[24.3px]",
              {
                "text-left": contentPage.titleAlignment === "left",
                "text-center": contentPage.titleAlignment === "center",
                "text-right": contentPage.titleAlignment === "right",
              },
            ]}
          >
            {contentPage.title}
          </h1>
        )}
        {contentPage.pageType === "segmented" ? (
          <SegmentedPageFullscreen client:load page={contentPage} />
        ) : (
          <ContentPageMarkdown
            client:load
            html={contentPage.contentHtml}
            recessed={contentPage.contentCardStyle === "recessed"}
            className={MD_FULLSCREEN}
          />
        )}
      </main>
      </div>
    )}

    {contentPage && overlayMode && renderStaticContent && (
      <main id="main-content" class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 pt-content-safe pb-12">
        {contentPage.pageType === "segmented" ? (
          contentPage.segments.map((segment) => (
            <MarkdownHtml html={segment.contentHtml} className={`${MD_FULLSCREEN} mb-8`} />
          ))
        ) : (
          <MarkdownHtml html={contentPage.contentHtml} className={MD_FULLSCREEN} />
        )}
      </main>
    )}

    {contentPage && overlayMode && !renderStaticContent && (
      <Fragment>
        <main id="main-content" class="flex-1 flex flex-col">
          <LandingPage client:idle showFooter={false} exampleShortId={exampleShortId} />
        </main>
        <PageOverlayIsland client:load initialPage={contentPage} />
      </Fragment>
    )}

    {!contentPage && ccPageProps && (
      <CcSharePageShell
        client:load
        config={ccPageProps.config}
        artistName={ccPageProps.artistName}
        artistInfo={ccPageProps.artistInfo}
        labels={ccPageProps.labels}
        shareId={shortId}
        supportPrompts={supportPrompts}
      />
    )}

    {!contentPage && !ccPageProps && shareView && (
      <SharePageShell
        client:load
        config={shareView.config}
        artistName={shareView.artistName}
        artistInfoContext={shareView.artistInfoContext}
        shareId={shortId}
        supportPrompts={supportPrompts}
      />
    )}

    <DeferredFooter server:defer />
  </div>

  {!routeError && (!contentPage || contentPage.displayMode === "fullscreen") && (
    <PageOverlayIsland client:load initialPage={null} />
  )}
</BaseLayout>
